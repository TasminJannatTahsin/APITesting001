      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "//Assertion for the status code\r",
              "pm.test('Verify that the showing status code is correct or not',function(){\r",
              "    pm.expect(pm.response.code).to.eql(200);\r",
              "})\r",
              "//Assertion for the response time\r",
              "pm.test('Verify that the showing reponse time is expected or not',function(){\r",
              "    //pm.expect(pm.response.responseTime).to.be.below(2000);\r",
              "    //pm.expect(pm.response.responseTime).to.be.above(2000);\r",
              "    pm.expect(pm.response.responseTime).to.be.within(200,3000);\r",
              "})\r",
              "//Assertion for the file size\r",
              "pm.test('Verify that the showing file size is expected or not',function(){\r",
              "   pm.expect(pm.response.responseSize).to.be.below(1000);\r",
              "   //pm.expect(pm.response.responseSize).to.be.above(1000);\r",
              "})\r",
              "\r",
              "//Assertion for the data format\r",
              "pm.test('Verify that the showing data format  is json or not',function(){\r",
              "  pm.response.to.have.jsonBody();\r",
              "   //pm.expect(pm.response.responseSize).to.be.above(1000);\r",
              "})\r",
              "//Assertion for checking booking id 12\r",
              "pm.test('Verify that the booking id 12 or not',function(){\r",
              "   var responseBody=pm.response.json();\r",
              "   var exists=responseBody.some(item=>item.bookingid===12);\r",
              "   pm.expect(exists).to.be.true;\r",
              "})\r",
              "//Assertion for the total number of booking ids\r",
              "pm.test('Verify that the Booking IDs are available',function(){\r",
              "   var responseBody=pm.response.json();\r",
              "    //pm.expect(responseBody.length).to.eql(8050);\r",
              "    pm.expect(responseBody.length).to.be.above(0);\r",
              "})\r",
              "pm.test('Verify that the Booking IDs are available',function(){\r",
              "    var responseBody=pm.response.json();\r",
              "    pm.expect(responseBody.length).to.be.a(\"number\");\r",
              "})\r",
              "//Assertion for the showing total number in console\r",
              "var responseBody=pm.response.json();\r",
              "console.log(\"Total Booking IDs:\", responseBody.length);\r",
              "\r",
              "pm.test(\"Verify that the displaying total Booking IDs\", function () {\r",
              "    pm.expect(responseBody.length).to.be.above(0);\r",
              "});\r",
              "pm.test(\"Verify every object contains a bookingid\", function () {\r",
              "    responseBody.forEach(item => {\r",
              "        pm.expect(item).to.have.property(\"bookingid\");\r",
              "    });\r",
              "});"
