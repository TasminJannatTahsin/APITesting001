              "pm.test('Verify required properties exist',function(){\r",
              "   pm.expect(responseBody.booking).to.have.all.keys(\r",
              "        \"firstname\",\r",
              "        \"lastname\",\r",
              "        \"totalprice\",\r",
              "        \"depositpaid\",\r",
              "        \"bookingdates\",\r",
              "        \"additionalneeds\"\r",
              "    );\r",
              "});\r",
